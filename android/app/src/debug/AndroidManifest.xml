<?xml version="1.0" encoding="utf-8"?>
<!--
  CSAK A DEBUG VARIÁNSHOZ — a Gradle ezt a főmanifesthez fűzi hozzá, a
  kiadási buildbe viszont nem kerül bele semmi innen.

  Ez a fájl adja hozzá a Firebase Test Lab Game Loop belépőjét. A
  `com.google.test.loops` a scenariók SZÁMA (1..1024); a Test Lab a
  `scenario-numbers` kapcsolóval választ közülük. A négyes a
  `src/admin/gameLoopScenarios.ts` pályakönyvéhez igazodik — ha ott új pálya
  kerül a listába, ezt a számot is emelni kell, különben a Test Lab nem
  engedi elindítani.

  ⚠️ Az `application` csomópontnak NEM adunk itt attribútumot: a manifest
  merger a főmanifesttel dolgozik, ez csak KIEGÉSZÍT.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <meta-data
            android:name="com.google.test.loops"
            android:value="4" />

        <activity
            android:name=".GameLoopActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="com.google.intent.action.TEST_LOOP" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/javascript" />
            </intent-filter>

        </activity>

    </application>

</manifest>
