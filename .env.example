# Másold .env.local néven, és töltsd ki. A .env.local NEM kerül verziókövetésbe.
#
# ⚠️ EBBE A FÁJLBA SOHA NE KERÜLJÖN VALÓDI TITOK.
# Az alábbi Firebase-értékek tervezetten publikusak (a böngészőbe letöltött
# JS-be is beépülnek), ezért itt maradhatnak. DE: a service account JSON, a
# konnektorok (Wahoo, Polar, Hammerhead) client secretjei, az e-mail-küldő
# API kulcsa és a Google "Web client secret" NEM ide valók — azok
# szerveroldalra, Secret Managerbe kerülnek. Ez a repó publikus.

# ── Firebase (kliens) ────────────────────────────────────────────────
# Firebase Console → Projekt beállítások → Saját alkalmazások → Web
#
# FIGYELEM a nevekre — három hasonló név van a projektben:
#   GRUNDO      az app / termék neve
#   grundo      a Firebase PROJEKT azonosítója
#   groundo-db  a Firestore ADATBÁZIS neve
VITE_FIREBASE_API_KEY=AIzaSyCKa86mPUV1AXDRnSc_duZoOYlnFxGcT6w
VITE_FIREBASE_AUTH_DOMAIN=grundo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=grundo
VITE_FIREBASE_STORAGE_BUCKET=grundo.firebasestorage.app
# Dedikált Firestore adatbázis — NEM a (default)! Lásd AGENTS.md.
VITE_FIRESTORE_DATABASE_ID=groundo-db
VITE_FIREBASE_MESSAGING_SENDER_ID=65689674957
VITE_FIREBASE_APP_ID=1:65689674957:web:1e5550ab3562d31aa13584

# ── Mapbox ───────────────────────────────────────────────────────────
# Nyilvános (pk.) token. Állíts be URL-korlátozást a Mapbox fiókban!
VITE_MAPBOX_TOKEN=
# Két stílus kell: a téma váltásakor a térkép is vált.
VITE_MAPBOX_STYLE_LIGHT=mapbox://styles/mapbox/light-v11
VITE_MAPBOX_STYLE_DARK=mapbox://styles/mapbox/dark-v11

# ── Backend (Cloud Run) ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ── App Check ────────────────────────────────────────────────────────
# MOST NEM KELL. Semmi nem olvassa: az App Check nincs inicializálva a
# kódban, ez az F6 (éles indulás) fázis feladata. Ne vedd fel titkos
# értékként sehova, amíg nem tartunk ott.
#
# Amikor aktuális lesz: Firebase Console → Build → App Check → Apps →
# Register → reCAPTCHA Enterprise. A kapott Key ID kerül ide. A natív
# appok NEM ezt használják (App Attest / Play Integrity), csak a web.
# VITE_RECAPTCHA_SITE_KEY=

# ── Fejlesztői kapcsolók ─────────────────────────────────────────────
# 1 = a Firebase emulátorhoz csatlakozik localhoston
VITE_USE_EMULATORS=0


# ════════════════════════════════════════════════════════════════════
# SZERVER OLDAL (server/.env) — ezek SOSEM kerülhetnek a kliensbe
# ════════════════════════════════════════════════════════════════════
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# FIREBASE_PROJECT_ID=grundo
# FIRESTORE_DATABASE_ID=groundo-db
# PORT=8080
#
# Konnektor OAuth — éles környezetben Secret Managerből, ne fájlból
# WAHOO_CLIENT_ID=
# WAHOO_CLIENT_SECRET=
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=
# HAMMERHEAD_CLIENT_ID=
# HAMMERHEAD_CLIENT_SECRET=
#
# E-mail küldés (OTP)
# RESEND_API_KEY=
# MAIL_FROM=no-reply@grund.app
