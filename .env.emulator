# Helyi EMULÁTOROS fejlesztés — `npm run dev:emulator`
#
# Ez a fájl SZÁNDÉKOSAN a repóban van: egyetlen valódi értéket sem tartalmaz.
# A Firebase-emulátor nem ellenőrzi a kulcsokat, tehát a `demo-` előtagú
# projektazonosító és a helykitöltő kulcs elég ahhoz, hogy a kliens SDK
# elinduljon és az emulátorhoz csatlakozzon.
#
# ⚠️ A `demo-` ELŐTAG NEM DÍSZ. A Firebase eszközei a `demo-` kezdetű
# projektazonosítót külön kezelik: ilyenkor SOHA nem próbálnak valódi
# szolgáltatáshoz nyúlni. Ez a védőháló akadályozza meg, hogy egy elgépelt
# beállítás az éles `grundo` projektre írjon.
#
# A `.env.local` (Geri gépén az éles backend címével) ELŐBBRE van a Vite
# sorrendjében, mint ez a fájl — ezért a backend címét NEM itt állítjuk be,
# hanem kódból: emulátoros módban a kliens mindig a helyi szerverre néz
# (`src/lib/api.ts`, `EMULATOR_API_BASE`).

VITE_USE_EMULATORS=1

VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-grundo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-grundo
VITE_FIREBASE_STORAGE_BUCKET=demo-grundo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Ugyanaz a megnevezett adatbázis, mint élesben — az emulátor tudja kezelni.
VITE_FIRESTORE_DATABASE_ID=grundo-db
