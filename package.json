{
  "name": "grundo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GRUNDO — közösségi mozgás- és területfoglaló app",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-grundo \"vitest run --no-file-parallelism emulator\"",
    "rules:deploy": "firebase deploy --only firestore:rules,storage:rules",
    "indexes:deploy": "firebase deploy --only firestore:indexes",
    "emulators": "firebase emulators:start",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor-firebase/messaging": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@tanstack/react-query": "^5.59.0",
    "firebase": "^12.6.0",
    "h3-js": "^4.1.0",
    "mapbox-gl": "^3.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/mapbox-gl": "^3.4.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
