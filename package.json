{
  "name": "grundo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GRUNDO — közösségi mozgás- és területfoglaló app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:deploy": "firebase deploy --only firestore:rules,storage:rules",
    "indexes:deploy": "firebase deploy --only firestore:indexes",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "firebase": "^11.0.0",
    "h3-js": "^4.1.0",
    "mapbox-gl": "^3.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^3.4.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
