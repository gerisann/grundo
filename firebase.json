{
  "//": "FIGYELEM: a GRUND NEM az alapértelmezett (default) Firestore adatbázist használja, hanem egy dedikáltat: groundo. A tömb alakú firestore-konfiguráció a többadatbázisos mód — a database kulcs nélkül a deploy a default adatbázisra menne.",
  "firestore": [
    {
      "database": "groundo",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8081, "//": "az emulátorban is a groundo adatbázist használjuk" },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
