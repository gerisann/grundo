# Kizárólag nyilvános, kliensoldali production-konfiguráció kerülhet ide.
# A Web Push VAPID public key eleve bekerül a böngésző bundle-jébe; nem titok.
# Jelszó, privát APNs-kulcs, service account vagy szerver-token SOHA ne kerüljön ide.
VITE_FIREBASE_VAPID_KEY=BIMRvwkmQxpciXnk-3s5x_HqtKX5j8K7hDiQNhC3vV_shO_Kislr3iE4cDZ59Ih2wJLaA_0LK5YzbMAbiYEORL8

# ── Firebase web SDK konfiguráció ──────────────────────────────────────────
#
# ⚠️ EZEK NEM TITKOK. A Firebase web config minden kliensoldali bundle-be
# beépül, és a böngészőből bárki kiolvassa — a hozzáférést nem ez védi, hanem
# a `firestore.rules` és a `storage.rules`. Ezért kerülhetnek a repóba.
#
# ⚠️ AZÉRT KERÜLTEK IDE, MERT A HIÁNYUK ÉLES LEÁLLÁST OKOZOTT (2026-08-29).
# Korábban csak a Cloud Shell másolatának `.env.local` fájljában éltek, ami
# GITIGNORE-OLT — így a telepítés némán attól függött, KI melyik gépről
# buildel. Amikor a build először futott fejlesztői gépen, ezek üresen
# maradtak, és az éles oldal „A Firebase nincs beállítva" hibával fogadta a
# felhasználókat, bejelentkezés nélkül. A gépfüggést csak az szünteti meg, ha
# a nyilvános konfiguráció a repóban van.
#
# Az értékek forrása: `firebase apps:sdkconfig web <appId> --project grundo`.
VITE_FIREBASE_API_KEY=AIzaSyCKa86mPUV1AXDRnSc_duZoOYlnFxGcT6w
VITE_FIREBASE_AUTH_DOMAIN=grundo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=grundo
VITE_FIREBASE_STORAGE_BUCKET=grundo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=65689674957
VITE_FIREBASE_APP_ID=1:65689674957:web:1e5550ab3562d31aa13584

# Dedikált Firestore adatbázis — NEM a `(default)`. A kódban van rá tartalék
# érték (`src/lib/firebase.ts`), de kiírva egyértelmű.
VITE_FIRESTORE_DATABASE_ID=grundo-db
