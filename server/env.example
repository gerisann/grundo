# GRUNDO backend — környezeti változók
#
# Helyi futtatáshoz másold .env néven. Cloud Runon a --set-env-vars vagy a
# konzol Variables & Secrets fülén állítsd be ugyanezeket.

# ── Firestore ────────────────────────────────────────────────────────
# A dedikált adatbázis. NEM a (default)!
FIRESTORE_DATABASE_ID=grundo-db

# ── Belépés felhasználónévvel ────────────────────────────────────────
# A Firebase webes API-kulcsa (ugyanaz, mint a kliens VITE_FIREBASE_API_KEY-e).
# NEM titok: minden kliens-bundle tartalmazza. A szerver ezzel ellenőrizteti a
# jelszót a Google végpontján, amikor valaki a nevével lép be.
# Hiánya nem állítja meg a szolgáltatást — csak a névvel belépés ad 503-at.
FIREBASE_WEB_API_KEY=AIza...

# ── CORS ─────────────────────────────────────────────────────────────
# Vesszővel elválasztott lista. Csillag NEM használható, mert a kérések
# hitelesítettek.
ALLOWED_ORIGINS=https://grundo.ai.studio,http://localhost:5173

# ── E-mail (OTP-kód küldése) ─────────────────────────────────────────
# 'console' = a kód CSAK a szervernaplóba kerül (fejlesztéshez).
# Élesben ez NEM elég: a felhasználó nem kapja meg a kódot.
MAIL_PROVIDER=console
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
MAIL_FROM=GRUNDO <no-reply@grundo.hu>

# ── Helyi futtatás ───────────────────────────────────────────────────
# Cloud Runon NEM kell: a szolgáltatás a saját service accountjával fut.
# Helyben egy letöltött kulcsfájlra mutasson:
# GOOGLE_APPLICATION_CREDENTIALS=./grundo-service-account.json

PORT=8080
