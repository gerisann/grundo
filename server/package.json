{
  "name": "grundo-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GRUNDO backend — Cloud Run",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server/server.js",
