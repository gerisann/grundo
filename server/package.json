    "firebase-admin": "^13.0.0",
    "h3-js": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsc-alias": "^1.8.10"
  }
}