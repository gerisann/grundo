{
  "name": "grundo-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GRUNDO backend — Cloud Run",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:activity-privacy": "tsx src/scripts/migrateActivityPrivacy.ts",
    "role:set": "tsx src/scripts/setUserRole.ts",
    "inspect:world": "tsx src/scripts/inspectWorld.ts",
    "replay:world": "tsx src/scripts/replayWorld.ts",
    "rollover:seed": "tsx src/scripts/seedRollover.ts",
    "rollover:run": "tsx src/scripts/runRollover.ts",
    "clean:gp-ledger-junk": "tsx src/scripts/cleanGpLedgerJunk.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "express": "^4.21.1",
    "firebase-admin": "^13.0.0",
    "h3-js": "^4.1.0",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
