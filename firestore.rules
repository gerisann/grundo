rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// GRUNDO — Firestore biztonsági szabályok
//
// ALAPELV: az írás alapból TILTOTT. A kliens kizárólag azt írhatja, ami
// kifejezetten engedélyezve van itt. Minden játékadat (terület, GP, szint,
// jelvény, előfizetés, bizalmi pontszám) KIZÁRÓLAG szerveroldalról íródik,
// az Admin SDK-val, ami megkerüli ezeket a szabályokat.
//
// Részletek: docs/05-adatmodell.md
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Segédfüggvények ───────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Kétirányú tiltás: sem a tiltó, sem a tiltott nem látja a másikat.
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
          || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    function follows(followerUid, targetUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid));
    }

    // Csak a felsorolt mezők változhatnak ebben az írásban.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in ['owner', 'admin', 'moderator'];
    }

    /**
     * A választható cellaszínek — a `src/lib/cellColors.ts` tükre.
     *
     * ⚠️ KÉT HELYEN ÉL UGYANAZ A LISTA, mert a szabálynyelv nem tud modult
     * importálni. Ha a paletta bővül, MINDKETTŐT frissíteni kell — különben az
     * új szín a felületen kiválasztható, de az írás némán elhasal.
     */
    function freeCellColors() {
      return ['purple', 'violet', 'indigo', 'blue', 'sky', 'cyan', 'teal', 'green',
              'lime', 'yellow', 'amber', 'orange', 'red', 'rose', 'pink', 'slate'];
    }

    function proCellColors() {
      return ['electric-blue', 'aqua', 'ice', 'coral', 'gold', 'acid-green',
              'neon-green', 'neon-red', 'hot-pink', 'deep-green', 'deep-indigo',
              'electric-purple'];
    }

    /**
     * A PRÉMIUM SZÍN ZÁRJA — ezt a szerver kényszeríti ki, nem a felület.
     *
     * A felület elrejti a lakat mögötti színeket, de az csak kényelem: a
     * Firestore-t bárki hívhatja közvetlenül. A `pro.active` mező
     * szerveroldali (a felhasználó nem írhatja, lásd a mezőlistát fent),
     * ezért megbízható forrás a döntéshez.
     *
     * Ha a `cellColor` nem is változik ebben az írásban, a szabály nem szól
     * bele — így a többi profilmező szerkesztése érintetlen marad.
     */
    function cellColorAllowed() {
      return !('cellColor' in request.resource.data.diff(resource.data).affectedKeys())
        || request.resource.data.cellColor in freeCellColors()
        || (request.resource.data.cellColor in proCellColors()
            && resource.data.get('pro', {}).get('active', false) == true);
    }

    // ── users ─────────────────────────────────────────────────────────────

    match /users/{uid} {
      // A fő dokumentum fiók-, egészség- és játékadatot is tartalmaz, a
      // Firestore-szabályok pedig nem tudnak mezőszinten szűrni. Idegen profil
      // ezért kizárólag a mezőket fehérlistázó szerver API-n keresztül jön.
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // A felhasználó SAJÁT MAGÁRÓL is csak a megjelenítési és beállítási
      // mezőket írhatja. A játékállapot (level, gpTotal, territoryM2,
      // areaDay/areaWeek/areaMonth, trust, cellCount, zoneCount, counters,
      // pro, status, username) szerveroldali.
      allow update: if isSelf(uid) && onlyChanges([
        'displayName', 'photoURL', 'bio', 'city', 'countryCode',
        'units', 'body', 'timezone', 'cellColor', 'updatedAt'
      ]) && cellColorAllowed();

      allow create, delete: if false;  // regisztráció és törlés szerveroldalról

      // Privát beállítások — kizárólag a tulajdonosnak.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      // A közösségi gráfot idegen felhasználóról a szerver szűrt API-ja adja.
      match /following/{targetUid} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /followers/{sourceUid} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      // Tiltás és némítás.
      //
      // ⚠️ FIGYELEM: ez a `blocks` a felhasználó-TILTÁS, nem a rács. A
      // rács-blokk mutató szándékosan külön névtérben van (`blockIndex`),
      // mert az a felhasználó képernyőjét szolgálja — ha a rács-mutató is
      // itt lenne, a saját területét törölhetné le a térképéről.
      //
      // ⚠️ A TILTÁS ÍRÁSA 2026-08-20 óta SZERVEROLDALI. Két oka van:
      // a művelet ilyenkor bontja a követéseket és a függő kéréseket is
      // (`routes/users.ts` → block), és megírja a `blockedBy` tükröt, amiből
      // a feed a MÁSIK irányt szűri. Egy közvetlen kliens-írás mindkettőt
      // kihagyná, és a tiltás csak félig működne. A kliens az API-t hívja,
      // közvetlenül eddig sem írta.
      match /blocks/{targetUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Ki tiltott ENGEM — a szerver által írt tükör. Csak olvasható, és csak
      // a tulajdonosnak: ez a lista mondja meg a feednek, kinek az
      // aktivitásait ne mutassa.
      match /blockedBy/{sourceUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Riválisok — kitől vettél el területet, és ki tőled.
      //
      // ⚠️ CSAK A TULAJDONOS OLVASHATJA, a `followers`/`following`-gal
      // ellentétben. Egy idegen rivális-listája megmutatná, kitől szokott
      // veszíteni — vagyis készen adna egy célpontlistát. Ez nem publikus
      // közösségi gráf, hanem a saját összecsapás-történeted.
      //
      // Az írás szerveroldali: a számok növelése az aktivitás feldolgozásából
      // jön (`lib/rivals.ts`), és a KLIENS SOSEM ÍR JÁTÉKADATOT (AGENTS.md
      // 5. szabály) — egy kliens-írás itt tetszőleges rivalitást és
      // tetszőleges mezőszámot hazudhatna.
      match /rivals/{otherUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Mely rács-blokkokban van cellája? Szerveroldali mutató, rétegenként
      // egy dokumentum. A tulajdonos olvashatja (a saját területképernyője
      // ebből dolgozik), írni senki nem írhatja.
      match /blockIndex/{layer} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /mutes/{targetUid}  { allow read, write: if isSelf(uid); }

      match /badges/{badgeId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /passport/{iso} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      // Melyik bandákban vagyok tag — a `bandas/{id}/members/{uid}` tükre
      // (lásd `routes/bandas.ts` fejléce). Csak a tulajdonosnak, csak
      // olvasásra: a „saját bandáim" lista ebből megy, collectionGroup-
      // lekérdezés nélkül.
      match /bandas/{bandaId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Rám váró banda-meghívók tükre — a `bandas/{id}/invites/{uid}`
      // tükre (GRUNDO #30), ugyanazzal az indoklással, mint fent.
      match /bandaInvites/{bandaId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Felhasználónév-foglalás: csak olvasható (az egyediséget a szerver
    // tranzakcióban kezeli).
    match /usernames/{name} {
      allow read: if true;
      allow write: if false;
    }

    // ── activities ────────────────────────────────────────────────────────

    match /activities/{activityId} {
      function visibleToMe() {
        let a = resource.data;
        return isSelf(a.userId)
            || isAdmin()
            || (!blockedBetween(request.auth.uid, a.userId)
                && (a.visibility == 'everyone'
                    || (a.visibility == 'followers' && follows(request.auth.uid, a.userId))));
      }

      allow get, list: if signedIn() && visibleToMe();

      // A kliens csak a saját aktivitása leíró mezőit szerkesztheti.
      // A nyomvonal, a metrikák, a claim, a GP és a trust szerveroldali.
      // A leíró mezők szerkesztése a PATCH /api/activities/:id végponton megy.
      //
      // A `photos` azért NEM maradhat kliensről írható: a hivatkozás
      // útvonal-előtagját a szerver ellenőrzi (`activities/{uid}/{activityId}/`),
      // különben bárki behivatkozhatná más felhasználó fájljait a saját
      // aktivitásába. A szabály nyelve ilyen ellenőrzésre nem alkalmas.
      allow update: if false;

      // Létrehozás és törlés a szerveren keresztül (feldolgozás + területvisszavonás).
      allow create, delete: if false;

      // ── A TELJES, LEVÁGATLAN NYOMVONAL ──
      // Külön dokumentum, mert a Firestore-szabályok nem tudnak mezőszinten
      // szűrni: ha a fő dokumentumban lenne, bárki elolvashatná, aki az
      // aktivitást látja — és ezzel a privát zóna értelmét vesztené.
      match /private/{docId} {
        allow read: if isSelf(get(/databases/$(database)/documents/activities/$(activityId)).data.userId)
                    || isAdmin();
        allow write: if false;
      }

      /**
       * A darabolt foglalás részeredményei — BELSŐ KÖNYVELÉS.
       *
       * Csoportonként egy dokumentum, determinisztikus azonosítóval; ebből
       * áll össze a végén a GP és az összesítő. A kliensnek semmi dolga vele,
       * és nem is szabad írnia: abból hamis területelszámolás lenne.
       */
      match /claimParts/{groupId} {
        allow read, write: if false;
      }

      // A kedvelés a SZERVEREN keresztul megy (POST/DELETE /api/activities/:id/like).
      //
      // MIÉRT nem írhatja a kliens közvetlenül, ha csak a saját dokumentumáról
      // van szó? Mert a kedvelés KÉT dolgot változtat: ezt az aldokumentumot és
      // az aktivitás `likeCount` mezőjét. Az utóbbit a kliens nem írhatja
      // (lásd az `update` szabályt fent), tehát közvetlen írásnál a kettő
      // szétcsúszna: a szív tele lenne, a számláló nulla.
      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }

      // A hozzászólásírás is a szerveren megy — ugyanaz az ok, mint a
      // kedvelésnél: a `commentCount` az aktivitás dokumentumán él, és azt a
      // kliens nem írhatja. Ráadásul a moderáció (szűrés, jelentés,
      // sebességkorlát) is oda tartozik majd, nem a kliensbe.
      match /comments/{commentId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ── A JÁTÉKTÉR — kliensről soha nem írható ────────────────────────────

    // A hexrács cellatulajdonlása (res 9 blokkokban).
    match /grid/{blockId}          { allow read: if signedIn(); allow write: if false; }
    // Származtatott zónák (összefüggő birtokfoltok) a megjelenítéshez.
    match /zones/{zoneId}          { allow read: if signedIn(); allow write: if false; }
    match /territoryEvents/{id} {
      allow read: if signedIn()
                  && (isSelf(resource.data.recipientId) || isAdmin());
      allow write: if false;
    }
    match /gpLedger/{entryId} {
      allow read: if signedIn() && (isSelf(resource.data.userId) || isAdmin());
      allow write: if false;
    }
    // A napi soft cap tranzakciós állapota belső könyvelési adat.
    match /dailyGp/{entryId}       { allow read, write: if false; }
    match /leaderboards/{board}/entries/{rank} {
      allow read: if signedIn();
      allow write: if false;
    }

    // A bizalmi pontszám SOHA nem kerülhet kliensre — sem a szám, sem a
    // részjelek. A felhasználó csak az aktivitáson lévő verdiktet látja.
    match /activityTrust/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A részletes játékmenet-auditot kizárólag a szerver API-ja adja vissza
    // szerepkör-ellenőrzés után. Közvetlen kliensolvasásra nincs szükség.
    match /activityAudits/{activityId} {
      allow read, write: if false;
    }

    // ── bandas ────────────────────────────────────────────────────────────
    // Csoportok, ahol a tagok területe és pontja összeadódik
    // (docs/05-adatmodell.md → `bandas/{bandaId}`, GRUNDO #29).

    match /bandas/{bandaId} {
      allow get, list: if signedIn()
        && (resource.data.visibility == 'public'
            || exists(/databases/$(database)/documents/bandas/$(bandaId)/members/$(request.auth.uid)));
      // Létrehozás, csatlakozás, meghívókód-generálás, a rollup-job írása:
      // mind szerveroldalon (lásd `routes/bandas.ts`, `jobs/bandaRollover.ts`).
      allow write: if false;

      match /members/{uid} { allow read: if signedIn(); allow write: if false; }

      // Appon belüli meghívások (GRUNDO #30) — csak a meghívott olvashatja
      // a sajátját, minden írás szerveroldalon (`routes/bandas.ts`).
      match /invites/{uid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Hírfolyam és chat fal (GRUNDO #30) — csak tagoknak olvasható, minden
      // írás szerveroldalon (a `postPermission`/jogosultság ellenőrzésével).
      match /feed/{postId} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/bandas/$(bandaId)/members/$(request.auth.uid));
        allow write: if false;
      }
      match /wall/{msgId} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/bandas/$(bandaId)/members/$(request.auth.uid));
        allow write: if false;
      }
    }

    match /inviteCodes/{code} { allow read, write: if false; }  // csak szerver

    // ── challenges ────────────────────────────────────────────────────────

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if false;
      match /participants/{uid} {
        allow read: if signedIn();
        allow write: if false;  // a csatlakozás és a haladás szerveroldali
      }
    }

    // ── notifications / messages ──────────────────────────────────────────

    match /notifications/{uid}/items/{itemId} {
      allow read: if isSelf(uid);
      // A felhasználó csak olvasottnak jelölheti.
      allow update: if isSelf(uid) && onlyChanges(['read']);
      /*
        TÖRÖLNI SZABAD, LÉTREHOZNI NEM.

        Az értesítés keletkezése a szerveré (`createNotification` — az az
        egyetlen kapu, ami a felhasználó kapcsolóit nézi), a saját listája
        viszont a felhasználóé: az értesítés-lapon a kártyát jobbra húzva
        vagy a fejléc „összes törlése" gombjával takaríthat.
      */
      allow delete: if isSelf(uid);
      allow create: if false;
    }

    match /conversations/{conversationId} {
      function participant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow read: if participant();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSelf(request.resource.data.senderId)
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ── reports ───────────────────────────────────────────────────────────

    match /reports/{reportId} {
      // A bejelentő létrehozhatja, de utána nem látja és nem módosítja.
      allow create: if signedIn()
        && isSelf(request.resource.data.reporterId)
        && request.resource.data.category in
           ['gps_spoof', 'vehicle', 'wrong_type', 'offensive', 'privacy', 'other']
        && request.resource.data.status == 'open';
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /reporterCredibility/{uid} { allow read: if isAdmin(); allow write: if false; }

    // ── egyéb felhasználói tartalom ───────────────────────────────────────

    match /equipment/{itemId} {
      allow read: if signedIn();
      // A km-gyűjtés szerveroldali, a leíró mezők a felhasználóé.
      allow create: if isSelf(request.resource.data.userId);
      allow update: if isSelf(resource.data.userId)
                    && onlyChanges(['name', 'type', 'targetKm', 'active', 'retiredAt']);
      allow delete: if isSelf(resource.data.userId);
    }

    match /routes/{routeId} {
      allow read: if signedIn() && (isSelf(resource.data.userId)
                                    || resource.data.visibility == 'public');
      allow create: if isSelf(request.resource.data.userId);
      allow update, delete: if isSelf(resource.data.userId);
    }

    match /trainingPlans/{planId} { allow read: if signedIn(); allow write: if false; }
    match /badges/{badgeId}       { allow read: if signedIn(); allow write: if false; }
    match /subscriptions/{uid}    { allow read: if isSelf(uid); allow write: if false; }
    match /connectors/{uid}/{provider} {
      // A tokenek Secret Managerben vannak; itt csak státusz.
      allow read: if isSelf(uid);
      allow write: if false;
    }
    match /devices/{uid}/tokens/{token} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid);  // FCM token regisztráció
    }

    // ── konfiguráció és napló ─────────────────────────────────────────────

    match /appConfig/{docId}  { allow read: if signedIn(); allow write: if false; }
    match /adminAudit/{docId} { allow read: if isAdmin();  allow write: if false; }

    /**
     * A konfiguráció verziótörténete — csak adminnak.
     *
     * A hatályos értékeket mindenki olvashatja (kell is: a szabálymagyarázó
     * felület ebből dolgozik), de hogy MIKOR MIT állítottunk át, az üzemeltetői
     * információ.
     */
    match /appConfig/{docId}/versions/{version} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /**
     * Modifierek — időszakos szorzók.
     *
     * SZÁNDÉKOSAN OLVASHATÓ mindenkinek: a játékosnak látnia kell, hol és
     * meddig érvényes a bónusz, különben az akciónak nincs értelme. Írni
     * kizárólag szerverről lehet — a `from`/`to` és a `value` játékadat.
     */
    match /modifiers/{modifierId} { allow read: if signedIn(); allow write: if false; }

    // Üzemeltetési adat: napi használati aggregátum és a job-futások naplója.
    match /metricsDaily/{day}    { allow read: if isAdmin(); allow write: if false; }
    match /rolloverRuns/{runId}  { allow read: if isAdmin(); allow write: if false; }
    match /rateLimits/{counterId} { allow read, write: if false; }

    // ── minden más tiltva ─────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
