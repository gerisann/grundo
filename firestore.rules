rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// GRUNDO — Firestore biztonsági szabályok
//
// ALAPELV: az írás alapból TILTOTT. A kliens kizárólag azt írhatja, ami
// kifejezetten engedélyezve van itt. Minden játékadat (terület, GP, szint,
// jelvény, előfizetés, bizalmi pontszám) KIZÁRÓLAG szerveroldalról íródik,
// az Admin SDK-val, ami megkerüli ezeket a szabályokat.
//
// Részletek: docs/05-adatmodell.md
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Segédfüggvények ───────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Kétirányú tiltás: sem a tiltó, sem a tiltott nem látja a másikat.
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
          || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    function follows(followerUid, targetUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid)/followers/$(followerUid));
    }

    // Csak a felsorolt mezők változhatnak ebben az írásban.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role in ['owner', 'admin', 'moderator'];
    }

    /**
     * A választható cellaszínek — a `src/lib/cellColors.ts` tükre.
     *
     * ⚠️ KÉT HELYEN ÉL UGYANAZ A LISTA, mert a szabálynyelv nem tud modult
     * importálni. Ha a paletta bővül, MINDKETTŐT frissíteni kell — különben az
     * új szín a felületen kiválasztható, de az írás némán elhasal.
     */
    function freeCellColors() {
      return ['purple', 'violet', 'indigo', 'blue', 'sky', 'cyan', 'teal', 'green',
              'lime', 'yellow', 'amber', 'orange', 'red', 'rose', 'pink', 'slate'];
    }

    function proCellColors() {
      return ['electric-blue', 'aqua', 'ice', 'coral', 'gold', 'acid-green',
              'neon-green', 'neon-red', 'hot-pink', 'deep-green', 'deep-indigo',
              'electric-purple'];
    }

    /**
     * A PRÉMIUM SZÍN ZÁRJA — ezt a szerver kényszeríti ki, nem a felület.
     *
     * A felület elrejti a lakat mögötti színeket, de az csak kényelem: a
     * Firestore-t bárki hívhatja közvetlenül. A `pro.active` mező
     * szerveroldali (a felhasználó nem írhatja, lásd a mezőlistát fent),
     * ezért megbízható forrás a döntéshez.
     *
     * Ha a `cellColor` nem is változik ebben az írásban, a szabály nem szól
     * bele — így a többi profilmező szerkesztése érintetlen marad.
     */
    function cellColorAllowed() {
      return !('cellColor' in request.resource.data.diff(resource.data).affectedKeys())
        || request.resource.data.cellColor in freeCellColors()
        || (request.resource.data.cellColor in proCellColors()
            && resource.data.get('pro', {}).get('active', false) == true);
    }

    // ── users ─────────────────────────────────────────────────────────────

    match /users/{uid} {
      // Privát fiók profilját csak elfogadott követő és a tulajdonos látja.
      allow get, list: if signedIn()
        && !blockedBetween(request.auth.uid, uid)
        && (isSelf(uid)
            || isAdmin()
            || resource.data.privacy.account == 'public'
            || follows(request.auth.uid, uid));

      // A felhasználó SAJÁT MAGÁRÓL is csak a megjelenítési és beállítási
      // mezőket írhatja. A játékállapot (level, gpTotal, territoryM2,
      // areaDay/areaWeek/areaMonth, trust, cellCount, zoneCount, counters,
      // pro, status, username) szerveroldali.
      allow update: if isSelf(uid) && onlyChanges([
        'displayName', 'photoURL', 'bio', 'city', 'countryCode',
        'units', 'body', 'timezone', 'cellColor', 'updatedAt'
      ]) && cellColorAllowed();

      allow create, delete: if false;

      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      match /following/{targetUid} { allow read: if signedIn(); allow write: if false; }
      match /followers/{sourceUid} { allow read: if signedIn(); allow write: if false; }

      match /blocks/{targetUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /blockedBy/{sourceUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /rivals/{otherUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /blockIndex/{layer} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
      match /mutes/{targetUid}  { allow read, write: if isSelf(uid); }

      match /badges/{badgeId}   { allow read: if signedIn(); allow write: if false; }
      match /passport/{iso}     { allow read: if signedIn(); allow write: if false; }
    }

    match /usernames/{name} {
      allow read: if true;
      allow write: if false;
    }

    // ── activities ────────────────────────────────────────────────────────

    match /activities/{activityId} {
      function visibleToMe() {
        let a = resource.data;
        return isSelf(a.userId)
            || isAdmin()
            || (!blockedBetween(request.auth.uid, a.userId)
                && (a.visibility == 'everyone'
                    || (a.visibility == 'followers' && follows(request.auth.uid, a.userId))));
      }

      allow get, list: if signedIn() && visibleToMe();
      allow update: if false;
      allow create, delete: if false;

      match /private/{docId} {
        allow read: if isSelf(get(/databases/$(database)/documents/activities/$(activityId)).data.userId)
                    || isAdmin();
        allow write: if false;
      }

      match /claimParts/{groupId} {
        allow read, write: if false;
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ── A JÁTÉKTÉR — kliensről soha nem írható ────────────────────────────

    match /grid/{blockId}          { allow read: if signedIn(); allow write: if false; }
    match /zones/{zoneId}          { allow read: if signedIn(); allow write: if false; }
    match /territoryEvents/{id} {
      allow read: if signedIn()
                  && (isSelf(resource.data.recipientId) || isAdmin());
      allow write: if false;
    }
    match /gpLedger/{entryId} {
      allow read: if signedIn() && (isSelf(resource.data.userId) || isAdmin());
      allow write: if false;
    }
    match /dailyGp/{entryId}       { allow read, write: if false; }
    match /leaderboards/{board}/entries/{rank} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /activityTrust/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /activityAudits/{activityId} {
      allow read, write: if false;
    }

    // ── clubs ─────────────────────────────────────────────────────────────

    match /clubs/{clubId} {
      allow get, list: if signedIn()
        && (resource.data.visibility == 'public'
            || exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)));
      allow write: if false;

      match /members/{uid}      { allow read: if signedIn(); allow write: if false; }
      match /joinRequests/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid);
        allow update: if false;
      }
    }

    match /inviteCodes/{code} { allow read, write: if false; }

    // ── challenges ────────────────────────────────────────────────────────

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if false;
      match /participants/{uid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // ── notifications / messages ──────────────────────────────────────────

    match /notifications/{uid}/items/{itemId} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid) && onlyChanges(['read']);
      allow delete: if isSelf(uid);
      allow create: if false;
    }

    match /conversations/{conversationId} {
      function participant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow read: if participant();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSelf(request.resource.data.senderId)
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ── reports ───────────────────────────────────────────────────────────

    match /reports/{reportId} {
      allow create: if signedIn()
        && isSelf(request.resource.data.reporterId)
        && request.resource.data.category in
           ['gps_spoof', 'vehicle', 'wrong_type', 'offensive', 'privacy', 'other']
        && request.resource.data.status == 'open';
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /reporterCredibility/{uid} { allow read: if isAdmin(); allow write: if false; }

    // ── egyéb felhasználói tartalom ───────────────────────────────────────

    match /equipment/{itemId} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.userId);
      allow update: if isSelf(resource.data.userId)
                    && onlyChanges(['name', 'type', 'targetKm', 'active', 'retiredAt']);
      allow delete: if isSelf(resource.data.userId);
    }

    match /routes/{routeId} {
      allow read: if signedIn() && (isSelf(resource.data.userId)
                                    || resource.data.visibility == 'public');
      allow create: if isSelf(request.resource.data.userId);
      allow update, delete: if isSelf(resource.data.userId);
    }

    match /trainingPlans/{planId} { allow read: if signedIn(); allow write: if false; }
    match /badges/{badgeId}       { allow read: if signedIn(); allow write: if false; }
    match /subscriptions/{uid}    { allow read: if isSelf(uid); allow write: if false; }
    match /connectors/{uid}/{provider} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    match /devices/{uid}/tokens/{token} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid);
    }

    // ── konfiguráció és napló ─────────────────────────────────────────────

    match /appConfig/{docId}  { allow read: if signedIn(); allow write: if false; }
    match /adminAudit/{docId} { allow read: if isAdmin();  allow write: if false; }

    match /appConfig/{docId}/versions/{version} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /modifiers/{modifierId} { allow read: if signedIn(); allow write: if false; }
    match /metricsDaily/{day}    { allow read: if isAdmin(); allow write: if false; }
    match /rolloverRuns/{runId}  { allow read: if isAdmin(); allow write: if false; }

    // ── minden más tiltva ─────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
