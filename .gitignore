node_modules/
dist/
dist-server/
.vite/

# Környezeti változók — soha ne kerüljön verziókövetésbe
.env
.env.local
.env.*
!.env.example
!.env.production
*-service-account.json
serviceAccountKey.json

# Átmeneti munkafájlok
tmp/*
!tmp/.gitkeep

# GraphHopper helyi futtatás — a jar (~47 MB) és az OSM-kivonat (~320 MB) a
# graphhopper/README.md szerint tölthető le, a gráf-gyorsítótár pedig belőlük
# épül; egyik sem verziókövetésre való.
graphhopper/*.jar
graphhopper/*.osm.pbf
graphhopper/graph-cache/
graphhopper/*.log

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
# Az `emulators:export` a repo gyökerébe teszi a kimentett emulátor-állapotot,
# ha nem adunk meg célmappát — és megszakadt exportnál is otthagyja.
firebase-export-*/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

