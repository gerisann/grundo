ios/App/Pods/
ios/DerivedData/
ios/**/*.xcarchive
ios/**/*.xcuserstate
ios/**/xcuserdata/
android/.gradle/
android/app/build/

# Apple aláírás — kizárólag Codemagic/Apple felületen kezelhető
